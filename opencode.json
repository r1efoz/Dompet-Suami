{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "bash": {
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add *": "allow",
      "git commit*": "allow",
      "git rm *": "allow",
      "git mv *": "allow",
      "git restore --staged*": "allow",
      "git push*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "npm run check*": "allow",
      "npm run build*": "allow",
      "npm run test:ui*": "allow",
      "npx tsx *": "allow",
      "TZ=* npx tsx *": "allow",
      "TZ=* npm run check*": "allow",
      "node scripts/make-icons.mjs*": "allow",
      "psql -h 127.0.0.1 -p 55322 *": "allow",
      "PGPASSWORD=postgres psql -h 127.0.0.1 -p 55322 *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "wc *": "allow",
      "lsof *": "allow",
      "mkdir *": "allow",
      "cat .env*": "deny",
      "cat supabase/.temp*": "deny",
      "vercel *": "deny",
      "direnv *": "deny",
      "supabase *": "deny",
      "curl *": "deny",
      "npm install*": "deny",
      "npm i *": "deny",
      "npm add *": "deny",
      "pnpm *": "deny",
      "yarn *": "deny",
      "rm -rf *": "deny",
      "*": "deny"
    }
  }
}
