# Dompet Suami - Environment variables
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real secrets.

# Vite only exposes variables prefixed with VITE_ to client code.
# This app currently runs fully client-side (localStorage), so no
# variables are required for local development.

# Example future backend API (uncomment & set when adding a backend):
# VITE_API_BASE_URL=http://localhost:3001
# VITE_API_KEY=your_key_here

# Example feature flag (uncomment to use):
# VITE_ENABLE_EXPORT_CSV=true
