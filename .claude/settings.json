{
  "permissions": {
    "disableBypassPermissionsMode": "disable"
  },
  "rules": {
    "deny": [
      {
        "name": "block-secrets",
        "description": "Block agent access to secret/config files",
        "match": [
          ".env*",
          "*.pem",
          "*.key",
          "*.crt",
          "credentials.json",
          "service-account.json",
          "*.seed",
          "wallet/*"
        ]
      },
      {
        "name": "block-settings-edit",
        "description": "Block agent edits to config files",
        "match": [
          ".claude/settings.json",
          ".mcp.json",
          ".github/workflows/**"
        ]
      },
      {
        "name": "block-read-secrets",
        "description": "Block agent reads of secrets",
        "match": [
          ".env*",
          "*.pem",
          "*.key",
          "*.crt"
        ],
        "actions": ["read"]
      }
    ]
  }
}
